{
  "compilerOptions": {
    "target": "ES2022",
    "downlevelIteration": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts", "scripts/**/*.mjs", "electron/**/*.ts", "src/types/**/*.ts"]
}
